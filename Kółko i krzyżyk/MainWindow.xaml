<Window x:Class="Kółko_i_krzyżyk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Kółko_i_krzyżyk"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="3*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <UniformGrid Rows="3" Columns="3" Name="GameGrid">
            <Button FontSize="36" Name="Btn0" Click="Button_Click"/>
            <Button FontSize="36" Name="Btn1" Click="Button_Click"/>
            <Button FontSize="36" Name="Btn2" Click="Button_Click"/>
            <Button FontSize="36" Name="Btn3" Click="Button_Click"/>
            <Button FontSize="36" Name="Btn4" Click="Button_Click"/>
            <Button FontSize="36" Name="Btn5" Click="Button_Click"/>
            <Button FontSize="36" Name="Btn6" Click="Button_Click"/>
            <Button FontSize="36" Name="Btn7" Click="Button_Click"/>
            <Button FontSize="36" Name="Btn8" Click="Button_Click"/>
        </UniformGrid>
        
        <StackPanel Grid.Row="1" Orientation="Vertical" Margin="0,10,0,0">
            <TextBlock Name="StatusText" FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,10"/>
            <Button Content="Resetuj grę" Click="ResetGame_Click" Width="120" HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>